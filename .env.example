# Environment for the production stack (docker-compose.yml).
# In Dokploy, paste these into the Compose service's Environment tab.
# Never commit the real values.

# Generate secrets with: openssl rand -hex 32   (hex keeps URLs safe)
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional (defaults shown)
POSTGRES_USER=wahednur
POSTGRES_DB=wahednur

# Plain VPS with automatic HTTPS: keep `proxy`. Add `frontend` to host the site here too.
# Behind Dokploy: leave this empty.
COMPOSE_PROFILES=proxy
API_DOMAIN=api.wahednur.tech

# Public addresses
ALLOWED_HOSTS=api.wahednur.tech
CORS_ALLOWED_ORIGINS=https://www.wahednur.tech,https://wahednur.tech
CSRF_TRUSTED_ORIGINS=https://api.wahednur.tech
# Used only if the `frontend` profile is on. On Vercel set it in Vercel's env instead.
NEXT_PUBLIC_API_URL=https://api.wahednur.tech

# Sign-in. FRONTEND_URL is the site people sign in on. COOKIE_DOMAIN lets the session cookie be
# shared by www and api (note the leading dot); leave it empty for local work.
FRONTEND_URL=https://www.wahednur.tech
COOKIE_DOMAIN=.wahednur.tech
# Google sign-in (create an OAuth client in Google Cloud Console; see docs/AUTH.md). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Staff and owner accounts must have two-factor authentication. Keep true in production.
REQUIRE_STAFF_MFA=true

# Email (sign-in codes, password resets, contact-form notices). Choose ONE way to send:
#
# A) Gmail or any SMTP server (simple; Gmail needs a 16-character "App password" with 2-step
#    verification on; limit about 500 emails a day; the sender must be that Gmail address)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_FROM=you@gmail.com
#
# B) Resend (needs the domain verified in Resend). Leave the EMAIL_* lines above EMPTY to use it.
RESEND_API_KEY=
LEADS_FROM_EMAIL=Wahed Nur <noreply@wahednur.tech>
#
# Who gets the contact-form notices
LEADS_NOTIFY_TO=wahednur@gmail.com

# Proxies in front of the API: 1 = Caddy (or Traefik) only,
# 2 = Cloudflare orange-cloud proxy + Caddy.
NUM_PROXIES=1
ADMIN_URL=manage-site/

# Cloudflare R2. Public bucket (site assets, phase 8):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Private bucket (document vault). Leave empty to use a local folder in dev:
R2_PRIVATE_ACCOUNT_ID=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
DOCUMENTS_MAX_MB=20
DOCUMENTS_URL_TTL=300

# Shown on quotation and invoice PDFs
BUSINESS_NAME=Abdul Wahed Nur
BUSINESS_EMAIL=wahednur@gmail.com
BUSINESS_ADDRESS=Sherpur, Bangladesh
INVOICE_PAYMENT_NOTE=

# AI-assisted SEO (optional). Comma list in order of preference: anthropic, gemini, groq.
# Leave empty to use the free rule-based generator.
AI_PROVIDERS=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Same value here and in the website's REVALIDATE_SECRET (Vercel). Lets the API refresh pages instantly.
REVALIDATE_SECRET=

# Shop: hours before an unpaid order is released and its stock returned
SHOP_PAYMENT_HOURS=48

# Public images (product photos). The address the PUBLIC bucket is served from, no trailing slash:
# in Cloudflare R2 open the public bucket, connect a custom domain (for example cdn.wahednur.tech)
# or enable the r2.dev address, and paste it here.
R2_PUBLIC_URL=
