# Reverse proxy for the API with automatic HTTPS (Let's Encrypt).
# API_DOMAIN comes from .env (for example api.wahednur.tech).
{$API_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy api:8000
	log {
		output stdout
		format console
	}
}

# The React admin dashboard. Only answers when ADMIN_DOMAIN is set and the `admin` profile is running.
{$ADMIN_DOMAIN:admin.localhost} {
	encode zstd gzip
	reverse_proxy admin:8080
	log {
		output stdout
		format console
	}
}
